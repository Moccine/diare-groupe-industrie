APP_ENV=dev
APP_SECRET=8f4c2a91e7b64d05a3c8e1f6b290d47c
APP_TIMEZONE=Europe/Paris
DEFAULT_URI=http://localhost:8086

DATABASE_URL="mysql://symfony:symfony_password@db:3306/diare_groupe?serverVersion=mariadb-11.4.0&charset=utf8mb4"

MAILER_DSN=smtp://mailpit:1025
MAIL_FROM_EMAIL=noreply@diaregroupe.local
MAIL_FROM_NAME="Diaré Groupe Industrie"

# reCAPTCHA v3. Désactivé en local : aucun appel Google.
RECAPTCHA_ENABLED=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# sync:// : les e-mails partent immédiatement vers Mailpit, sans worker.
MESSENGER_TRANSPORT_DSN=sync://
GOOGLE_ANALYTICS_MEASUREMENT_ID=
APP_INDEXABLE=0

# Destinataire RH des candidatures. Vide : email de l’offre, puis email public du site.
JOB_APPLICATION_NOTIFY_EMAIL=
# Alerte du formulaire de contact. Vide : email public du site (SiteSettings).
# Ne pas y mettre ADMIN_EMAIL ni une adresse inventée.
CONTACT_NOTIFY_EMAIL=
# Mois de conservation. Vide : aucune date de fin, aucune purge automatique.
JOB_APPLICATION_RETENTION_MONTHS=

ADMIN_EMAIL=admin@diare.local
ADMIN_PASSWORD=
