# Production — copier vers l’environnement du serveur et remplacer les placeholders.
# Ne jamais committer de vraie clé.

APP_ENV=prod
APP_SECRET=change-me
APP_TIMEZONE=Europe/Paris
DEFAULT_URI=https://example.com

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/diare_groupe?serverVersion=mariadb-11.4.0&charset=utf8mb4"

# Brevo SMTP. Le login et la clé SMTP viennent du compte Brevo.
# En local, Docker force Mailpit : ne pas utiliser cette valeur sur la machine de développement.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAILER_DSN="smtp://${BREVO_SMTP_LOGIN}:${BREVO_SMTP_KEY}@smtp-relay.brevo.com:587"

MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME="Diaré Groupe Industrie"

# reCAPTCHA v3. Laisser 0 tant que les clés Google ne sont pas posées.
RECAPTCHA_ENABLED=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
