# Production — copier vers backend/.env.local sur le serveur.
# Remplacer chaque placeholder. Ne jamais committer ce fichier une fois rempli.
# Les valeurs ci-dessous ne sont pas des secrets réels.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-with-a-long-random-secret
APP_TIMEZONE=Europe/Paris

# URL canonique du site (https://domaine ou https://www.domaine).
# Utilisée pour les URL absolues (sitemap, canonical CLI, e-mails, Messenger).
# Le logo des e-mails n’est affiché que si cette adresse est en https public.
# Préproduction : https://preprod.example.com et APP_INDEXABLE=0.
DEFAULT_URI=https://example.com

# Base et utilisateur dédiés. Ne jamais utiliser root.
# serverVersion doit rester une version MariaDB.
DATABASE_URL="mysql://diare_prod:CHANGE_ME@127.0.0.1:3306/diare_groupe_industrie?serverVersion=mariadb-11.4.0&charset=utf8mb4"

# Brevo API, comme le projet catalogue. Clé API (xkeysib-…), pas le login SMTP.
# Ne pas committer la clé.
BREVO_API_KEY=
MAILER_DSN=brevo+api://default

# Expéditeur transactionnel. Distinct de la boîte de réception (SiteSettings.email).
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="Diaré Groupe Industrie"

# Alerte du formulaire de contact.
# 1. CONTACT_NOTIFY_EMAIL, s’il est valide.
# 2. Sinon l’email public du site (SiteSettings), s’il est valide.
# Vide : pas d’adresse ici. Ne pas y mettre ADMIN_EMAIL ni une adresse inventée.
CONTACT_NOTIFY_EMAIL=

# reCAPTCHA v3. RECAPTCHA_ENABLED=1 sans clés fait échouer le formulaire public.
RECAPTCHA_ENABLED=1
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# GA4. Vide = aucun script Analytics. Format attendu : G-XXXXXXXX.
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# 1 = indexable (production). 0 = robots Disallow et noindex (préproduction).
APP_INDEXABLE=1

# File Doctrine. auto_setup=0 : la table messenger_messages vient de la migration.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Compte admin, créé à la main avec app:create-admin. Jamais au déploiement.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Candidatures. Vide : email de l’offre, puis l’email public du site (SiteSettings).
# Ne pas inventer d’adresse. Ne pas y mettre une boîte personnelle non validée.
JOB_APPLICATION_NOTIFY_EMAIL=
# Durée de conservation en mois, uniquement après décision de l’entreprise.
# Vide : aucune échéance enregistrée. La purge n’est jamais lancée par le déploiement.
JOB_APPLICATION_RETENTION_MONTHS=
