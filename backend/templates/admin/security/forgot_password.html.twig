{% extends 'base.html.twig' %}

{% block main %}
    <section class="section login">
        <div class="container login__panel">
            <p class="eyebrow">Administration</p>
            <h1>Mot de passe oublié</h1>
            <p class="login__hint">Indiquez l’adresse email du compte. S’il existe, un lien de réinitialisation sera envoyé. Il reste valable une heure.</p>
            {% form_theme form 'form/contact_layout.html.twig' %}
            {% for message in app.flashes('success') %}
                <p class="form-banner form-banner--success" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="form-banner form-banner--error" role="alert">{{ message }}</p>
            {% endfor %}
            {{ form_start(form, { attr: { class: 'contact-form', novalidate: 'novalidate' } }) }}
                {{ form_row(form.email) }}
                {{ form_row(form.website) }}
                <button class="button" type="submit">Envoyer le lien</button>
            {{ form_end(form) }}
            <p class="login__links"><a href="{{ path('admin_login') }}">Retour à la connexion</a></p>
        </div>
    </section>
{% endblock %}
