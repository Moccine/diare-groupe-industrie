{% extends 'base.html.twig' %}

{% block main %}
    <section class="section login">
        <div class="container login__panel">
            <p class="eyebrow">Administration</p>
            <h1>Connexion</h1>
            {% for message in app.flashes('success') %}
                <p class="form-banner form-banner--success" role="status">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="form-banner form-banner--error" role="alert">{{ message }}</p>
            {% endfor %}
            {% if error %}
                <p class="form-banner form-banner--error" role="alert">Identifiants incorrects.</p>
            {% endif %}
            <form method="post" action="{{ path('admin_login') }}" class="contact-form">
                <label for="username">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                <label for="password">Mot de passe</label>
                <div class="password-field">
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                    <button class="password-field__toggle" type="button" data-password-toggle aria-controls="password" aria-pressed="false" aria-label="Afficher le mot de passe">
                        <svg class="password-field__icon" data-password-icon="show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="password-field__icon" data-password-icon="hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden>
                            <path d="M3 3l18 18"/>
                            <path d="M10.6 6.2A10.4 10.4 0 0 1 12 6c6.5 0 10 6 10 6a18.2 18.2 0 0 1-3.2 3.8"/>
                            <path d="M6.1 6.8C3.5 8.6 2 12 2 12s3.5 6 10 6c1.4 0 2.7-.3 3.8-.8"/>
                            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
                        </svg>
                    </button>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="button" type="submit">Se connecter</button>
            </form>
            <p class="login__links"><a href="{{ path('admin_forgot_password') }}">Mot de passe oublié ?</a></p>
        </div>
    </section>
{% endblock %}
