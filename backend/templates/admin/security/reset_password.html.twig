{% extends 'base.html.twig' %}

{% macro toggle(id) %}
    <button class="password-field__toggle" type="button" data-password-toggle aria-controls="{{ id }}" aria-pressed="false" aria-label="Afficher le mot de passe">
        <svg class="password-field__icon" data-password-icon="show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/>
            <circle cx="12" cy="12" r="3"/>
        </svg>
        <svg class="password-field__icon" data-password-icon="hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden>
            <path d="M3 3l18 18"/>
            <path d="M10.6 6.2A10.4 10.4 0 0 1 12 6c6.5 0 10 6 10 6a18.2 18.2 0 0 1-3.2 3.8"/>
            <path d="M6.1 6.8C3.5 8.6 2 12 2 12s3.5 6 10 6c1.4 0 2.7-.3 3.8-.8"/>
            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
        </svg>
    </button>
{% endmacro %}
{% import _self as fields %}

{% block main %}
    <section class="section login">
        <div class="container login__panel">
            <p class="eyebrow">Administration</p>
            <h1>Nouveau mot de passe</h1>
            {% form_theme form 'form/contact_layout.html.twig' %}
            {% for message in app.flashes('error') %}
                <p class="form-banner form-banner--error" role="alert">{{ message }}</p>
            {% endfor %}
            {{ form_start(form, { attr: { class: 'contact-form', novalidate: 'novalidate' } }) }}
                {{ form_errors(form.plainPassword) }}
                <div class="form-field{{ form.plainPassword.vars.valid ? '' : ' is-invalid' }}">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_errors(form.plainPassword.first) }}
                    <div class="password-field">
                        {{ form_widget(form.plainPassword.first) }}
                        {{ fields.toggle(form.plainPassword.first.vars.id) }}
                    </div>
                </div>
                <div class="form-field{{ form.plainPassword.vars.valid ? '' : ' is-invalid' }}">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword.second) }}
                    <div class="password-field">
                        {{ form_widget(form.plainPassword.second) }}
                        {{ fields.toggle(form.plainPassword.second.vars.id) }}
                    </div>
                </div>
                <p class="login__hint">8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un caractère spécial.</p>
                <button class="button" type="submit">Enregistrer le mot de passe</button>
            {{ form_end(form) }}
            <p class="login__links"><a href="{{ path('admin_login') }}">Retour à la connexion</a></p>
        </div>
    </section>
{% endblock %}
