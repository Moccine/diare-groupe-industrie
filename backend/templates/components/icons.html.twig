{% macro icon(name, class) %}
    <svg class="icon {{ class|default('') }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {% if name == 'adresse' %}
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"/>
            <circle cx="12" cy="10" r="2.2"/>
        {% elseif name == 'telephone' %}
            <path d="M7.2 4.8h2.2l1.2 3-1.5 1a12.5 12.5 0 0 0 5.1 5.1l1-1.5 3 1.2v2.2a1.5 1.5 0 0 1-1.6 1.5A14.5 14.5 0 0 1 5.7 6.4a1.5 1.5 0 0 1 1.5-1.6z"/>
        {% elseif name == 'email' %}
            <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/>
            <path d="m4.5 7 7.5 6L19.5 7"/>
        {% elseif name == 'emploi' %}
            <rect x="3" y="7" width="18" height="12" rx="1.5"/>
            <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7"/>
            <path d="M3 12h18"/>
        {% elseif name == 'actualite' %}
            <path d="M5 4.5h11.5A1.5 1.5 0 0 1 18 6v13.5H6.5A1.5 1.5 0 0 1 5 18V4.5z"/>
            <path d="M8 8.5h7M8 12h7M8 15.5h4"/>
        {% elseif name == 'partenaire' %}
            <circle cx="8" cy="9" r="2.2"/>
            <circle cx="16" cy="9" r="2.2"/>
            <path d="M4.5 18.5v-1.2A3.3 3.3 0 0 1 7.8 14h.4"/>
            <path d="M19.5 18.5v-1.2A3.3 3.3 0 0 0 16.2 14h-.4"/>
            <path d="M12 13.2v5.3"/>
        {% elseif name == 'fleche' %}
            <path d="M4 12h15"/>
            <path d="m13 6 6 6-6 6"/>
        {% elseif name == 'produit' %}
            <path d="M12 3.5 20 7.5v9L12 20.5 4 16.5v-9L12 3.5z"/>
            <path d="M12 12 20 7.5M12 12v8.5M12 12 4 7.5"/>
        {% elseif name == 'industrie' %}
            <path d="M3.5 20V9.5L9 13V9.5l6 3.5V8l5.5 3"/>
            <path d="M3.5 20h17"/>
            <path d="M7 20v-3M11 20v-3M15 20v-3"/>
        {% elseif name == 'qualite' %}
            <path d="M12 3.5 19 6.5v5.2c0 4.2-2.8 7.2-7 8.8-4.2-1.6-7-4.6-7-8.8V6.5L12 3.5z"/>
            <path d="m8.8 12 2.1 2.1 4.3-4.4"/>
        {% elseif name == 'distribution' %}
            <circle cx="6" cy="7" r="2"/>
            <circle cx="18" cy="7" r="2"/>
            <circle cx="12" cy="17" r="2"/>
            <path d="M8 8.2 10.6 15M16 8.2 13.4 15"/>
        {% elseif name == 'mission' %}
            <circle cx="12" cy="12" r="7.5"/>
            <circle cx="12" cy="12" r="3.5"/>
            <circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>
        {% elseif name == 'vision' %}
            <path d="M2.5 12S6.2 6.5 12 6.5 21.5 12 21.5 12 17.8 17.5 12 17.5 2.5 12 2.5 12z"/>
            <circle cx="12" cy="12" r="2.4"/>
        {% elseif name == 'milk' %}
            <path d="M9 3.5h6l-.6 3.2a6.2 6.2 0 0 1-4.8 0L9 3.5z"/>
            <path d="M8.2 8.2h7.6l.7 2.2a5.2 5.2 0 0 1-9 0l.7-2.2z"/>
            <path d="M8.5 13.2c.4 3.8 1.6 6.3 3.5 7.3 1.9-1 3.1-3.5 3.5-7.3"/>
        {% elseif name == 'biscuit' %}
            <circle cx="12" cy="12" r="7.2"/>
            <circle cx="9" cy="10" r="0.7" fill="currentColor" stroke="none"/>
            <circle cx="13.2" cy="8.6" r="0.7" fill="currentColor" stroke="none"/>
            <circle cx="14.4" cy="13.2" r="0.7" fill="currentColor" stroke="none"/>
            <circle cx="10.2" cy="14.4" r="0.7" fill="currentColor" stroke="none"/>
        {% elseif name == 'sugar' or name == 'sucre' %}
            <path d="M8 8.5 12 4.5l4 4"/>
            <path d="M7 9.5h10v8.2a1.3 1.3 0 0 1-1.3 1.3H8.3A1.3 1.3 0 0 1 7 17.7V9.5z"/>
            <path d="M7 13h10"/>
        {% else %}
            <rect x="4" y="4" width="16" height="16" rx="1.5"/>
            <path d="M8 12h8M12 8v8"/>
        {% endif %}
    </svg>
{% endmacro %}

{% macro activity_icon(title) %}
{%- set value = title|lower -%}
{%- if 'lait' in value or 'conditionnement' in value -%}produit
{%- elseif 'biscuit' in value or 'fabrication' in value -%}biscuit
{%- elseif 'sucre' in value or 'raffinage' in value -%}sucre
{%- elseif 'distribution' in value or 'distributeur' in value -%}distribution
{%- elseif 'qualité' in value or 'qualite' in value -%}qualite
{%- else -%}industrie
{%- endif -%}
{% endmacro %}

{% macro value_icon(title) %}
{%- set value = title|lower -%}
{%- if 'qualité' in value or 'qualite' in value -%}qualite
{%- elseif 'service' in value or 'client' in value -%}partenaire
{%- else -%}industrie
{%- endif -%}
{% endmacro %}
