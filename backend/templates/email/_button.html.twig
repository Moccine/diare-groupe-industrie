{% if url starts with 'https://' or url starts with 'http://' %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 8px;">
    <tr>
        <td align="center" bgcolor="{{ primary|default('#185424') }}" style="background-color:{{ primary|default('#185424') }};border-radius:4px;">
            <a href="{{ url }}" target="_blank" style="display:inline-block;padding:12px 20px;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;color:#ffffff;text-decoration:none;font-weight:bold;border:1px solid {{ primary|default('#185424') }};border-radius:4px;">{{ label }}</a>
        </td>
    </tr>
</table>
{% endif %}
