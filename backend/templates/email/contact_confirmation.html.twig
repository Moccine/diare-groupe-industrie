{% extends 'email/layout.html.twig' %}

{% block title %}Nous avons bien reçu votre message{% endblock %}
{% block preheader %}Nous avons bien reçu votre message.{% endblock %}

{% block body %}
    <h1 style="{{ titleStyle }}">Nous avons bien reçu votre message</h1>
    <p style="{{ textStyle }}">Bonjour {{ request.firstName }},</p>
    <p style="{{ textStyle }}">Nous avons bien reçu votre message concernant « {{ request.subject }} ».</p>
    <p style="{{ textStyle }}">Notre équipe reviendra vers vous dès que possible.</p>
    <p style="{{ textStyle }}margin-bottom:8px;">Cordialement,<br>{{ settings.companyName }}</p>
{% endblock %}
