{% extends 'email/layout.html.twig' %}

{% block title %}Nouveau message reçu{% endblock %}
{% block preheader %}Un nouveau message est arrivé depuis le formulaire de contact.{% endblock %}

{% block body %}
    <h1 style="{{ titleStyle }}">Nouveau message reçu</h1>
    <p style="{{ textStyle }}">Un visiteur a écrit depuis le formulaire de contact.</p>
    {% include 'email/_rows.html.twig' with { rows: [
        { label: 'Nom et prénom', value: request.fullName },
        { label: 'Entreprise', value: request.company },
        { label: 'E-mail', value: request.email },
        { label: 'Téléphone', value: request.phone },
        { label: 'Objet', value: request.subject },
        { label: 'Date de réception', value: request.createdAt|date('d/m/Y H:i') },
    ] } %}
    <p style="{{ textStyle }}margin-top:18px;margin-bottom:8px;"><strong>Message</strong></p>
    <p style="{{ textStyle }}">{{ request.message|nl2br }}</p>
    {% include 'email/_button.html.twig' with { url: adminUrl, label: 'Consulter le message' } %}
{% endblock %}
