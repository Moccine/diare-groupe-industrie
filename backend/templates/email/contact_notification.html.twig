{% extends 'email/layout.html.twig' %}

{% block title %}Nouveau message reçu{% endblock %}

{% block body %}
    <h1 style="margin:0 0 12px;color:#185424;font-size:22px;">Nouveau message reçu</h1>
    <p style="margin:0 0 16px;">Un visiteur a écrit depuis le formulaire de contact.</p>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
        <tr><td style="padding:6px 0;"><strong>Nom :</strong> {{ request.fullName }}</td></tr>
        <tr><td style="padding:6px 0;"><strong>Entreprise :</strong> {{ request.company|default('—') }}</td></tr>
        <tr><td style="padding:6px 0;"><strong>Email :</strong> {{ request.email }}</td></tr>
        <tr><td style="padding:6px 0;"><strong>Téléphone :</strong> {{ request.phone|default('—') }}</td></tr>
        <tr><td style="padding:6px 0;"><strong>Objet :</strong> {{ request.subject }}</td></tr>
        <tr><td style="padding:6px 0;"><strong>Date :</strong> {{ request.createdAt|date('d/m/Y H:i') }}</td></tr>
    </table>
    <p style="margin:18px 0 8px;"><strong>Message</strong></p>
    <p style="margin:0;white-space:pre-line;">{{ request.message }}</p>
    <p style="margin:22px 0 0;">
        <a href="mailto:{{ request.email }}" style="display:inline-block;padding:10px 16px;background:#185424;color:#ffffff;text-decoration:none;">Répondre</a>
    </p>
{% endblock %}
