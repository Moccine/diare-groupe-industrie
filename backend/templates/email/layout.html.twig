{% set company = settings.companyName|default('Diaré Groupe Industrie') %}
{% set primary = email_color(settings.primaryColor|default(''), '#185424') %}
{% set secondary = email_color(settings.secondaryColor|default(''), '#0E3A18') %}
{% set accent = email_color(settings.accentColor|default(''), '#90B43C') %}
{% set logo = email_logo(settings) %}
{% set siteUrl = email_site_url() %}
{% set titleStyle = "margin:0 0 16px;font-family:Georgia,'Palatino Linotype',Palatino,serif;font-size:22px;line-height:1.3;color:" ~ primary ~ ";font-weight:bold;" %}
{% set textStyle = "margin:0 0 16px;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#142018;" %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{% block title %}{{ company }}{% endblock %}</title>
    <style type="text/css">
        @media only screen and (max-width: 620px) {
            .dgi-card { width: 100% !important; }
            .dgi-pad { padding-left: 18px !important; padding-right: 18px !important; }
            .dgi-label { display: block !important; width: auto !important; padding-bottom: 0 !important; }
        }
    </style>
</head>
<body style="margin:0;padding:0;background-color:#f7f8f4;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;color:#142018;">
    <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
        {% block preheader %}{{ company }}{% endblock %}
        {% for i in 1..60 %}&nbsp;&zwnj;{% endfor %}
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f8f4" style="background-color:#f7f8f4;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
                <table role="presentation" class="dgi-card" width="600" align="center" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background-color:#ffffff;">
                    <tr>
                        <td class="dgi-pad" bgcolor="{{ secondary }}" style="background-color:{{ secondary }};padding:22px 28px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    {% if logo %}
                                        <td valign="middle" style="padding-right:14px;">
                                            <img src="{{ logo.url }}" alt="{{ company }}" width="{{ logo.width }}" height="{{ logo.height }}" border="0" style="display:block;border:0;outline:none;text-decoration:none;width:{{ logo.width }}px;height:{{ logo.height }}px;">
                                        </td>
                                    {% endif %}
                                    <td valign="middle" style="font-family:Georgia,'Palatino Linotype',Palatino,serif;font-size:20px;line-height:1.3;color:#ffffff;font-weight:bold;">
                                        {{ company }}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td bgcolor="{{ accent }}" style="background-color:{{ accent }};height:4px;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>
                    <tr>
                        <td class="dgi-pad" style="padding:28px 28px 8px;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#142018;">
                            {% block body %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td class="dgi-pad" style="padding:8px 28px 28px;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#4e5c54;">
                            <p style="margin:0 0 8px;font-family:Georgia,'Palatino Linotype',Palatino,serif;font-size:15px;line-height:1.4;color:#142018;">{{ company }}</p>
                            {% if settings.address %}
                                <p style="margin:0 0 4px;">{{ settings.address|nl2br }}</p>
                            {% endif %}
                            {% if settings.phone %}
                                <p style="margin:0 0 4px;">
                                    {% if settings.phoneHref %}
                                        <a href="{{ settings.phoneHref }}" style="color:#4e5c54;text-decoration:underline;">{{ settings.phone }}</a>
                                    {% else %}
                                        {{ settings.phone }}
                                    {% endif %}
                                </p>
                            {% endif %}
                            {% if settings.hasPublicEmail %}
                                <p style="margin:0 0 4px;"><a href="mailto:{{ settings.email }}" style="color:#4e5c54;text-decoration:underline;">{{ settings.email }}</a></p>
                            {% endif %}
                            {% if siteUrl %}
                                <p style="margin:0 0 12px;"><a href="{{ siteUrl }}" style="color:{{ primary }};text-decoration:underline;">{{ siteUrl }}</a></p>
                            {% endif %}
                            {% if settings.copyright %}
                                <p style="margin:0 0 8px;">{{ settings.copyright }}</p>
                            {% endif %}
                            <p style="margin:0;">Message transactionnel envoyé automatiquement par le site de {{ company }}. Il fait suite à une action réalisée en ligne.</p>
                        </td>
                    </tr>
                </table>
                <!--[if mso]></td></tr></table><![endif]-->
            </td>
        </tr>
    </table>
</body>
</html>
