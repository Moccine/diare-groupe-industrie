{% extends 'email/layout.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe{% endblock %}
{% block preheader %}Lien pour choisir un nouveau mot de passe d’administration.{% endblock %}

{% block body %}
    <h1 style="{{ titleStyle }}">Réinitialisation de votre mot de passe</h1>
    <p style="{{ textStyle }}">Bonjour {{ user.fullName }},</p>
    <p style="{{ textStyle }}">Une demande de réinitialisation a été faite pour votre compte d’administration.</p>
    {% include 'email/_button.html.twig' with { url: resetUrl, label: 'Choisir un nouveau mot de passe' } %}
    <p style="{{ textStyle }}margin-top:18px;">Ce lien reste valable une heure. S’il ne s’ouvre pas, copiez cette adresse dans votre navigateur :</p>
    <p style="{{ textStyle }}font-size:13px;line-height:1.5;word-break:break-all;">{{ resetUrl }}</p>
    <p style="{{ textStyle }}margin-bottom:8px;">Si vous n’êtes pas à l’origine de cette demande, ignorez ce message. Votre mot de passe actuel reste inchangé.</p>
{% endblock %}
