{% extends 'base.html.twig' %}

{% block main %}
    {% set first = sections|first %}
    {% if first is null or first.section.type.value != 'hero' %}
        {% include 'partials/_page_banner.html.twig' with {
            title: page.title,
            lead: page.metaDescription,
            tone: page.slug,
            crumbs: [{ label: page.title }]
        } %}
    {% endif %}
    {% for block in sections %}
        {% include block.template with { section: block.section } %}
    {% endfor %}
{% endblock %}
