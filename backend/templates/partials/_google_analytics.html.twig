{% set ga_id = google_analytics_id|default('')|trim %}
{% if ga_id starts with 'G-' and app.request.cookies.get('analytics_consent') == 'accepted' %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id|e('html_attr') }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ ga_id|e('js') }}');
    </script>
{% endif %}
