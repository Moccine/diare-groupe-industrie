{# Le fond biscuits de l’accueil est sur fond noir : screen l’efface. Les autres photos produit restent en multiply. #}
<section class="section text-image theme-{{ section.theme.value }}{{ section.theme.value == 'image_left' or section.backgroundImage ? ' section--depth' : '' }}{{ section.backgroundImage ? ' has-section-bg' : '' }}{{ section.backgroundImage and section.page and section.page.slug == 'accueil' ? ' has-section-bg--screen' : '' }}">
    {% include 'components/_section_backdrop.html.twig' with { section: section } %}
    <div class="container text-image__grid">
        <div data-reveal="fade-up">
            {% include 'components/_section_title.html.twig' with { section: section, reveal: false } %}
            {% if section.content %}
                <div class="prose">{{ section.content|nl2br }}</div>
            {% endif %}
            <div class="section-actions">
                {% include 'components/_button.html.twig' with { label: section.buttonLabel, url: section.buttonUrl } %}
            </div>
        </div>
        {% set company_presentation = section.page and section.page.slug == 'a-propos' and section.type.value == 'text_image' and section.title == 'Présentation de la société' %}
        {% set legacy_logo = section.image and ('logo' in section.image.title|default('')|lower or 'logo' in section.image.alt|default('')|lower) %}
        {% if company_presentation and (not section.image or legacy_logo) %}
            {% include 'components/_presentation_video.html.twig' with {
                reveal: section.theme.value == 'image_left' ? 'fade-right' : 'fade-left'
            } %}
        {% elseif section.image %}
            <figure class="text-image__figure" data-reveal="{{ section.theme.value == 'image_left' ? 'fade-right' : 'fade-left' }}">
                <div class="text-image__frame" data-parallax="16">
                    {% include 'components/_media.html.twig' with { media: section.image } %}
                </div>
                {% if section.image.caption %}
                    <figcaption>{{ section.image.caption }}</figcaption>
                {% endif %}
            </figure>
        {% endif %}
    </div>
</section>
